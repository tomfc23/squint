{
  "name": "pi-squint",
  "version": "0.1.0",
  "description": "Compact transcript rendering for pi: interchangeable directions for tool calls, and styles for fenced code blocks",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tui",
    "transcript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomfc23/squint.git"
  },
  "homepage": "https://github.com/tomfc23/squint",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node logic.test.ts && node directions.test.ts && node codeblocks.test.ts && node menu.test.ts",
    "test:adapter": "node index.test.ts && node agents.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "index.ts",
    "agents.ts",
    "directions.ts",
    "logic.ts",
    "codeblocks.ts",
    "shim.ts",
    "menu.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6"
  }
}
