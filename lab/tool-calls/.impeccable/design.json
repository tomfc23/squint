  "components": [
    {
      "name": "Terminal Frame",
      "kind": "custom",
      "refersTo": "frame",
      "description": "The terminal viewport that holds one direction's full 20-case transcript.",
      "html": "<figure class=\"ds-frame\"><div class=\"ds-frame-bar\"><span class=\"ds-frame-id\">pi / squint render lab / Badge</span><span class=\"ds-frame-rt\">mock · dark · 132×44</span></div><div class=\"ds-frame-body\">transcript rows</div></figure>",
      "css": ".ds-frame{background:#191c22;border:1px solid #2b3038;border-radius:3px;overflow:hidden;max-width:1040px;font-family:\"JetBrains Mono\",ui-monospace,Menlo,monospace}.ds-frame-bar{display:flex;justify-content:space-between;gap:16px;padding:8px 13px;border-bottom:1px solid #2b3038;background:#1b1e25;font:600 11px/1 \"Schibsted Grotesk\",system-ui,sans-serif;letter-spacing:.04em;color:#7e888e}.ds-frame-bar .ds-frame-rt{font-family:\"JetBrains Mono\",monospace;font-weight:400}.ds-frame-body{padding:16px 13px 12px}"
    },
    {
      "name": "Badge Chip",
      "kind": "chip",
      "refersTo": "chip-tool",
      "description": "The incumbent rendering's one loud element: a filled label carrying the tool category, never the state.",
      "html": "<span class=\"ds-chip\" style=\"background:#4D9ABF\">READ</span> <span class=\"ds-chip-sum\">extensions/squint/index.ts</span>",
      "css": ".ds-chip{display:inline-block;background:#4D9ABF;color:#181a20;font:700 12px/1.5 \"JetBrains Mono\",monospace;padding:0 5px;border-radius:1px;letter-spacing:.02em}.ds-chip-sum{margin-left:8px;color:#dee0e1;font:400 12.5px/1.62 \"JetBrains Mono\",monospace}"
    },
    {
      "name": "Transcript Row",
      "kind": "custom",
      "refersTo": "row",
      "description": "One tool call: a full-width button header, an always-visible preview slice, and the hidden remainder behind the reveal.",
      "html": "<div class=\"ds-row\"><button class=\"ds-row-head\" aria-expanded=\"false\"><span class=\"ds-chip\" style=\"background:#4D9ABF\">READ</span><span class=\"ds-chip-sum\">logic.ts</span></button><div class=\"ds-row-pre\"><span>190#XXMT:export function previewLines(</span><span>191#YYNU:\treturn { shown: list.slice(0, limit) };</span></div><span class=\"ds-row-hint\">+34 more · click to expand</span></div>",
      "css": ".ds-row{padding:1px 0}.ds-row-head{display:flex;gap:8px;align-items:baseline;width:100%;text-align:left;background:none;border:0;padding:0;font:inherit;color:inherit;cursor:pointer}.ds-row-pre{display:flex;flex-direction:column;padding-left:7ch;color:#9da5a9;font:400 12.5px/1.62 \"JetBrains Mono\",monospace}.ds-row-pre span{white-space:pre;overflow:hidden;text-overflow:ellipsis}.ds-row-hint{display:block;padding-left:7ch;padding-top:2px;color:#7e888e;font:400 11.5px/1.6 \"JetBrains Mono\",monospace}.ds-row-head:focus-visible{outline:2px solid #a798d7;outline-offset:3px}"
    },
    {
      "name": "Ledger Row",
      "kind": "custom",
      "refersTo": "ledger-row",
      "description": "The density extreme: one aligned row per call, mark / label / target / count / time, and nothing else until it is opened.",
      "html": "<div class=\"ds-ledger\" style=\"--tk:#98C379\"><button class=\"ds-ledger-head\" aria-expanded=\"false\"><span class=\"ds-ledger-mk\"></span><span class=\"ds-ledger-lab\">READ</span><span class=\"ds-ledger-sum\">extensions/squint/index.ts</span><span class=\"ds-ledger-cnt\">42 lines</span><span class=\"ds-ledger-tm\">0.3s</span></button></div>",
      "css": ".ds-ledger-head{display:grid;grid-template-columns:2.4ch 7ch minmax(0,1fr) 7ch 6ch;gap:0 10px;align-items:baseline;width:100%;text-align:left;background:none;border:0;padding:0 6px;border-radius:2px;font:400 12.5px/1.75 \"JetBrains Mono\",monospace;color:inherit;cursor:pointer}.ds-ledger-head:hover{background:#1f232b}.ds-ledger-mk{width:7px;height:7px;border-radius:1px;background:var(--tk);align-self:center;justify-self:center}.ds-ledger-lab{color:var(--tk);font-weight:600;letter-spacing:.05em}.ds-ledger-sum{color:#dee0e1;white-space:pre;overflow:hidden;text-overflow:ellipsis}.ds-ledger-cnt,.ds-ledger-tm{color:#7e888e;text-align:right}"
    },
    {
      "name": "Gutter Row",
      "kind": "custom",
      "refersTo": "gutter-row",
      "description": "A typographic column instead of a chip: fixed-width label cell, target cell, right meta; output hangs off a 1px rule aligned to the target column.",
      "html": "<div class=\"ds-gutter\" style=\"--tk:#4D9ABF\"><button class=\"ds-gutter-head\" aria-expanded=\"false\"><span class=\"ds-gutter-gc\">READ</span><span class=\"ds-gutter-sum\">extensions/squint/index.ts</span><span class=\"ds-gutter-meta\">42 lines</span></button><div class=\"ds-gutter-pre\"><span>190#XXMT:export function previewLines(</span></div></div>",
      "css": ".ds-gutter-head{display:grid;grid-template-columns:8ch minmax(0,1fr) auto;gap:0 10px;align-items:baseline;width:100%;text-align:left;background:none;border:0;padding:0;font:400 12.5px/1.7 \"JetBrains Mono\",monospace;color:inherit;cursor:pointer}.ds-gutter-gc{color:var(--tk);font-size:11.5px;font-weight:600;letter-spacing:.06em}.ds-gutter-sum{color:#dee0e1;white-space:pre;overflow:hidden;text-overflow:ellipsis}.ds-gutter-meta{color:#7e888e;font-size:11.5px}.ds-gutter-pre{margin-left:calc(8ch + 10px);border-left:1px solid color-mix(in oklab, var(--tk) 30%, transparent);padding-left:11px;color:#9da5a9;font:400 12.5px/1.62 \"JetBrains Mono\",monospace;display:flex;flex-direction:column}"
    },
    {
      "name": "Deck Panel",
      "kind": "card",
      "refersTo": "deck-panel",
      "description": "Each call boxed: status dot, label, target, stats in the header, output inside, and a nested call as a box inside its parent's box.",
      "html": "<div class=\"ds-deck\" style=\"--tk:#56B6C2\"><div class=\"ds-deck-panel\"><button class=\"ds-deck-head\" aria-expanded=\"false\"><span class=\"ds-deck-dot\"></span><span class=\"ds-deck-dh\"><span class=\"ds-deck-lab\">READ</span><span class=\"ds-deck-sum\">index.ts</span></span><span class=\"ds-deck-meta\">42 lines · 0.3s</span></button><div class=\"ds-deck-pre\"><span>39#BRBH:const COLLAPSED = {</span></div></div></div>",
      "css": ".ds-deck{padding:5px 0;font-family:\"JetBrains Mono\",monospace}.ds-deck-panel{border:1px solid #2b3038;border-radius:2px;overflow:hidden;background:#1b1f26}.ds-deck-head{display:grid;grid-template-columns:3ch minmax(0,1fr) auto;gap:0 10px;align-items:baseline;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid #2b3038;padding:7px 11px;color:inherit;cursor:pointer}.ds-deck-dot{width:7px;height:7px;border-radius:50%;background:var(--tk);align-self:center;margin-left:2px}.ds-deck-dh{display:flex;gap:9px;align-items:baseline;min-width:0}.ds-deck-lab{color:var(--tk);font-size:11.5px;font-weight:600;letter-spacing:.05em}.ds-deck-sum{color:#dee0e1;font-size:12.5px;white-space:pre;overflow:hidden;text-overflow:ellipsis}.ds-deck-meta{color:#7e888e;font-size:11.5px}.ds-deck-pre{padding:8px 12px 6px;color:#9da5a9;font-size:12px;display:flex;flex-direction:column}"
    },
    {
      "name": "Rail Node",
      "kind": "custom",
      "refersTo": "rail-node",
      "description": "A call as a node on one continuous trace spine; nested work hangs off its parent with an elbow, which is the only way a subagent's shape is visible at a glance.",
      "html": "<div class=\"ds-rail\" style=\"--tk:#9D7CD8\"><button class=\"ds-rail-head\" aria-expanded=\"false\"><span class=\"ds-rail-node\"></span><span class=\"ds-rail-rh\"><span class=\"ds-rail-lab\">AGENT</span><span class=\"ds-rail-sum\">review-team · correctness</span></span><span class=\"ds-rail-meta\">3 tools · 12.4s</span></button></div>",
      "css": ".ds-rail{position:relative;padding-left:2.6ch;font-family:\"JetBrains Mono\",monospace}.ds-rail::before{content:\"\";position:absolute;left:5.5px;top:0;bottom:0;width:1px;background:#2b3038}.ds-rail-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:0 14px;align-items:baseline;width:100%;text-align:left;background:none;border:0;padding:0 0 0 1.6ch;font:400 12.5px/1.8 \"JetBrains Mono\",monospace;color:inherit;cursor:pointer}.ds-rail-node{position:absolute;left:0;top:.62em;width:11px;height:11px;border-radius:50%;background:#191c22;border:1px solid var(--tk);display:grid;place-items:center}.ds-rail-node::after{content:\"\";width:5px;height:5px;border-radius:50%;background:var(--tk)}.ds-rail-rh{display:flex;gap:10px;align-items:baseline;min-width:0}.ds-rail-lab{color:var(--tk);font-size:11.5px;font-weight:600;letter-spacing:.05em}.ds-rail-sum{color:#dee0e1;white-space:pre;overflow:hidden;text-overflow:ellipsis}.ds-rail-meta{color:#7e888e;font-size:11.5px}"
    },
    {
      "name": "Diff Band",
      "kind": "custom",
      "refersTo": "diff-band",
      "description": "The one place a row is allowed to paint a full-bleed tint: an edit's changed lines, band from the indent column to the frame's edge, with context hidden until the row opens.",
      "html": "<div class=\"ds-diff\" style=\"--ind:7ch\"><span class=\"ds-diff-line ds-diff-add\">+\tread: 8,</span><span class=\"ds-diff-line ds-diff-del\">-\tread: 6,</span><span class=\"ds-diff-line ds-diff-ctx\">\tgrep: 8,</span></div>",
